{
  "name": "ReactBase",
  "version": "2.0.0",
  "private": true,
  "description": "Modernized React e-commerce project",
  "scripts": {
    "start": "webpack serve --config config/webpack.dev.js --mode development",
    "build": "webpack --config config/webpack.prod.js --mode production",
    "clean": "rimraf dist",
    "migrate": "npx ts-node ts-morph-todo-new.ts ",
    "migrate:1": "npx ts-node ts-morph-todo-migrate.ts",
    "putout": "putout new-src",
    "tsm:init": "ts-migrate init new-src",
    "tsm:rename": "ts-migrate rename new-src",
    "tsm:migrate": "ts-migrate migrate new-src",
    "tsm:all": "npm run tsm:init && npm run tsm:rename && npm run tsm:migrate",
    "jscodeshift-watch": "codemon node \"jscodeshift -t new-src/src/transform.js new-src\"",
    "jscodeshift-working": "jscodeshift -t new-src/src/transform.js new-src/src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "axios": "^1.6.7",
    "body-parser": "^2.2.0",
    "codemod": "^0.18.5",
    "codemon": "^0.1.31-development",
    "express": "^5.1.0",
    "fs-extra": "^11.3.0",
    "jscodeshift": "^17.3.0",
    "prop-types": "^15.8.1",
    "putout": "^40.1.17",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.2",
    "react-slick": "^0.30.0",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "^2.1.4",
    "slick-carousel": "^1.8.1",
    "ts-morph": "^26.0.0",
    "typescript": "^5.8.3",
    "zod": "^3.25.30"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/preset-env": "^7.24.5",
    "@babel/preset-react": "^7.22.5",
    "@types/fs-extra": "^11.0.4",
    "babel-loader": "^9.1.3",
    "cross-env": "^7.0.3",
    "css-loader": "^6.10.0",
    "html-webpack-plugin": "^5.5.3",
    "mini-css-extract-plugin": "^2.7.6",
    "rimraf": "^5.0.5",
    "sass": "^1.75.0",
    "sass-loader": "^14.1.1",
    "style-loader": "^3.3.4",
    "ts-migrate": "^0.1.35",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1",
    "webpack-merge": "^5.9.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
